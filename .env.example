# =========================================================
# GAME SHARE POC - copie para .env e ajuste
# NUNCA commite o arquivo .env
#
# Este arquivo tem DOIS cenarios. O de cima e o padrao e roda
# tudo na sua maquina. O de baixo e o que voce precisa para um
# amigo assistir de verdade.
# =========================================================


# =========================================================
# CENARIO 1 - LOCAL (padrao, tudo numa maquina so)
# =========================================================
# Requer `pnpm livekit:dev` rodando num terminal.

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_devsecret_devsecret_32

TOKEN_SERVER_PORT=8787
TOKEN_SERVER_HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174

VITE_TOKEN_SERVER_URL=http://127.0.0.1:8787
VITE_VIEWER_BASE_URL=http://localhost:5174


# =========================================================
# CENARIO 2 - REMOTO (um amigo assiste de outra rede)
# =========================================================
# Comente o bloco acima e descomente este. Precisa de tres coisas
# no ar: LiveKit Cloud, o token-server hospedado e o viewer em
# HTTPS. Ver a secao "Publicar" no README.
#
# 1. Crie um projeto em https://cloud.livekit.io e copie as
#    credenciais do painel (Settings > Keys).
# LIVEKIT_URL=wss://seu-projeto.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxxxxxx
# LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# 2. Token server. Muitos hosts (Railway, Render, Fly) injetam
#    PORT sozinhos - o servidor usa PORT quando TOKEN_SERVER_PORT
#    nao existe. TOKEN_SERVER_HOST precisa ser 0.0.0.0, senao o
#    processo so aceita conexoes locais e o host nao alcanca.
# TOKEN_SERVER_HOST=0.0.0.0
#
# 3. CORS. So estas origens conseguem pedir token. Coloque o
#    dominio do viewer. Se for empacotar o Electron, acrescente
#    `null` - uma janela carregada de file:// envia Origin nulo.
# ALLOWED_ORIGINS=https://seu-viewer.exemplo.com
#
# 4. Clientes. Vao para o bundle: NUNCA coloque segredo aqui.
# VITE_TOKEN_SERVER_URL=https://seu-token-server.exemplo.com
# VITE_VIEWER_BASE_URL=https://seu-viewer.exemplo.com


# =========================================================
# Opcionais (valem para os dois cenarios)
# =========================================================

# TTL dos tokens em segundos (padrao 6h)
TOKEN_TTL_SECONDS=21600

# Limite de criacao de salas por IP, por janela de 15 min.
# E a UNICA barreira real da API publica: criar sala nao exige credencial e
# consome cota do LiveKit. CORS nao ajuda aqui, ver "Seguranca" no README.
# RATE_LIMIT_ROOMS=10

# Limite de pedidos de token de viewer por IP, por janela de 15 min.
# Mais folgado: cada espectador pede pelo menos um ao entrar.
# RATE_LIMIT_VIEWERS=120

# Atras de proxy/CDN o IP real vem no X-Forwarded-For. Sem isto o
# rate limit enxerga um IP so e limita todo mundo junto.
# TRUST_PROXY=1
